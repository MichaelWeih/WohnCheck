DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wohnweise_kompass?schema=public"
PORT=3001
JWT_SECRET="replace-this-with-a-long-random-secret"

# ---------------------------------------------------------------------------------------------
# Landlord directory (all optional; see docs/vermieter-verzeichnis.md section 9)
# ---------------------------------------------------------------------------------------------

# Number of trusted reverse-proxy hops (needed for per-IP rate limiting behind a proxy), e.g. 1
# TRUST_PROXY=

# Secret for keyed hashes (search-on-miss cache keys, suppression list). Falls back to JWT_SECRET.
# PRIVACY_HASH_SECRET=

# --- Background jobs -----------------------------------------------------------------------------
# Run the job worker / the scheduler in this process (default true; both are off in tests).
# JOBS_WORKER_ENABLED=true
# JOBS_SCHEDULER_ENABLED=true
# Jobs executed in parallel by one process (default 2)
# JOBS_WORKER_CONCURRENCY=2
# Delete finished jobs after this many days (default 30)
# JOBS_RETENTION_DAYS=30

# --- Outbound requests to data sources -----------------------------------------------------------
# Contact shown to data providers in the User-Agent, e.g. "https://wohncheck.example/bot; kontakt@wohncheck.example".
# Wikimedia requires one; without it scheduled bulk syncs stay off and requests are throttled to the anonymous tier.
# OUTBOUND_CONTACT=

# --- Discovery -----------------------------------------------------------------------------------
# Sources that may be used (comma separated). Default: wikidata,gleif
# File-based sources additionally need their file: osm (OSM_EXPORT_FILE), offeneregister (OFFENEREGISTER_FILE).
# DISCOVERY_SOURCES=wikidata,gleif
# Scheduled network syncs. Default false: nothing crawls unless an admin starts it or this is true.
# DISCOVERY_AUTO_SYNC=false
# Search-on-miss for visitors (default true) and its global cap per hour (default 30)
# DISCOVERY_SEARCH_ON_MISS=true
# DISCOVERY_SEARCH_ON_MISS_MAX_PER_HOUR=30
# SPARQL endpoint of the Wikidata Query Service (the service is migrating to query-next.wikidata.org during 2026/27)
# WIKIDATA_SPARQL_URL=https://query.wikidata.org/sparql
# GeoJSON-Seq export of OpenStreetMap offices produced with osmium (see docs). OSM records stay candidates
# unless OSM_AUTO_PUBLISH=true (decide the ODbL share-alike question with a lawyer first).
# OSM_EXPORT_FILE=
# OSM_AUTO_PUBLISH=false
# JSON-lines dump from offeneregister.de (one-off seed, register state 2018/19)
# OFFENEREGISTER_FILE=

# --- External platforms --------------------------------------------------------------------------
# Flag confirmed external references for manual re-check after this many days (default 365)
# EXTERNAL_RECHECK_DAYS=365
